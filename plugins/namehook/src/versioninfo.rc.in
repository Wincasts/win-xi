#include "Version.h"

1 VERSIONINFO
 FILEVERSION NAMEHOOK_VERSION_MAJOR,NAMEHOOK_VERSION_MINOR,NAMEHOOK_VERSION_PATCH,0
 PRODUCTVERSION NAMEHOOK_VERSION_MAJOR,NAMEHOOK_VERSION_MINOR,NAMEHOOK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 4
 FILETYPE 2
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "BunnyBox Productions"
            VALUE "FileDescription", "https://www.github.com/Shirk/Nameplate - Corrects defects in nameplate rendering; namehook shows and hides names by category and lists them for addons"
            VALUE "FileVersion", NAMEHOOK_VERSION_FULL_TEXT
            VALUE "InternalName", "namehook"
            VALUE "LegalCopyright", "Copyright (c) 2024 BunnyBox Productions"
            VALUE "OriginalFilename", "namehook.dll"
            VALUE "ProductName", "namehook"
            VALUE "ProductVersion", NAMEHOOK_VERSION_FULL_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
