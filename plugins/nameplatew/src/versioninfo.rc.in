1 VERSIONINFO
 FILEVERSION 0,7,1,0
 PRODUCTVERSION 0,7,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 4
 FILETYPE 2
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "BunnyBox Productions"
            VALUE "FileDescription", "https://www.github.com/Shirk/Nameplate - Corrects defects in nameplate rendering; nameplatew adds party and whitelist name modes"
            VALUE "FileVersion","0.7.1.0\0"
            VALUE "InternalName", "nameplatew"
            VALUE "LegalCopyright", "Copyright (c) 2024 BunnyBox Productions"
            VALUE "OriginalFilename", "nameplatew.dll"
            VALUE "ProductName", "nameplatew"
            VALUE "ProductVersion","0.7.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
