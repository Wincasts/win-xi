1 VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 4
 FILETYPE 2
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "win"
            VALUE "FileDescription", "uihook - modular native UI replacement"
            VALUE "FileVersion", "0.3.0.0\0"
            VALUE "InternalName", "uihook"
            VALUE "LegalCopyright", "Copyright (c) 2026 win"
            VALUE "OriginalFilename", "uihook.dll"
            VALUE "ProductName", "uihook"
            VALUE "ProductVersion", "0.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
