1 VERSIONINFO
 FILEVERSION 0,94,0,0
 PRODUCTVERSION 0,94,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 4
 FILETYPE 2
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "win"
            VALUE "FileDescription", "lens - the world through a Panini or cylindrical projection"
            VALUE "FileVersion", "0.94.0.0\0"
            VALUE "InternalName", "lens"
            VALUE "LegalCopyright", "Copyright (c) 2026 win"
            VALUE "OriginalFilename", "lens.dll"
            VALUE "ProductName", "lens"
            VALUE "ProductVersion", "0.94.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
