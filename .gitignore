# The server source and other people's addons: reference material, kept out of this repository
/Phoenix-beta/
/references/

# The Phoenix server's live branch as tools/phoenix fetches it for the build scripts, and their scratch
/.cache/

__pycache__/
*.pyc

# The Ashita plugin SDK and the Microsoft C runtime and Windows SDK that plugins/*/build.sh build against
/.toolchain/

# Plugin build output, and the release zips tools/ makes from it
/plugins/*/build/
/dist/

# In-game screenshots taken while working, which can show character names
/screenshots/

# Map pictures exported from XICombinedMaps before zone read the game's files (winxi.mapdat)
/addons/zone/assets/maps/

# Combat diagnostics contain character names and raw packets
/addons/parse/captures/

# Retired diagnostic and experimental addons, kept locally for reference and never pushed
/archive/


# Text no release may hold (tools/package_release.py reads it): kept local
/.private-markers
